# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# ML artifacts — regenerated by train.py / downloaded by torchvision;
# never want a multi-GB dataset or checkpoint blob in git history.
data/
checkpoints/
*.pt
*.pth
*.ckpt

# Secrets — never commit real credentials; k8s/secrets are created with
# `kubectl create secret` or a sealed-secrets/external-secrets pipeline,
# not checked in. See README.md "Secrets management".
.env
*.env
secrets.yaml
**/secrets/*.yaml
!**/secrets/*.example.yaml

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
